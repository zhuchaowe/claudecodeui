# Example configuration for using claude-code-proxy with alternative AI providers

# Enable proxy mode by setting OPENAI_API_KEY
# This will start claude-code-proxy and redirect all Claude API calls to your chosen provider

# Example 1: Using DeepSeek
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
BIG_MODEL=deepseek-coder
SMALL_MODEL=deepseek-coder

# Example 2: Using Kimi (Moonshot)
# OPENAI_API_KEY=sk-your-moonshot-api-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# BIG_MODEL=kimi-k2-0711-preview
# SMALL_MODEL=kimi-k2-0711-preview

# Example 3: Using OpenAI GPT-4
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# BIG_MODEL=gpt-4
# SMALL_MODEL=gpt-3.5-turbo

# Example 4: Using local LLM (e.g., with Ollama)
# OPENAI_API_KEY=dummy-key
# OPENAI_BASE_URL=http://localhost:11434/v1
# BIG_MODEL=codellama:34b
# SMALL_MODEL=codellama:7b

# When proxy is enabled, these will be automatically set:
# ANTHROPIC_BASE_URL=http://localhost:8082
# ANTHROPIC_AUTH_TOKEN=some-api-key (if not already set)