# Claude Code UI Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
PORT=3008
#Frontend port
VITE_PORT=8080

# =============================================================================
# GITHUB OAUTH CONFIGURATION
# =============================================================================
# To use GitHub OAuth, you need to create a GitHub OAuth App:
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Fill in:
#    - Application name: Claude Code UI
#    - Homepage URL: http://localhost:3008 (or your production URL)
#    - Authorization callback URL: http://localhost:3008/api/github/callback
# 4. After creating, copy the Client ID and Client Secret below

# GitHub OAuth App Client ID
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitHub OAuth Redirect URI (should match the callback URL in your GitHub app)
GITHUB_REDIRECT_URI=http://localhost:3008/api/github/callback

# GitHub Organization Restrictions (optional)
# Comma-separated list of GitHub organizations that are allowed to login
# Leave empty to allow any GitHub user to login
# Example: GITHUB_ALLOWED_ORGS=my-org,another-org
GITHUB_ALLOWED_ORGS=

# GitHub Star Requirement (optional)
# Require users to star a specific repository before they can login
# Format: owner/repository-name
# Leave empty to disable star requirement
# Example: GITHUB_REQUIRED_STAR_REPO=anthropics/claude-code
GITHUB_REQUIRED_STAR_REPO=

# =============================================================================
# PROJECTS DIRECTORY CONFIGURATION
# =============================================================================
# Base directory where user projects are stored
# Each user will have their own subdirectory: {PROJECTS_DIR}/{username}
# Default: /home/claude/projects
PROJECTS_DIR=/home/claude/projects

# =============================================================================
# EMAIL NOTIFICATION CONFIGURATION (Optional)
# =============================================================================
# Configure SMTP settings for email notifications
# When Claude completes a task, you can receive email notifications

# SMTP Host (e.g., smtp.gmail.com, smtp-mail.outlook.com)
SMTP_HOST=

# SMTP Port (usually 587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS (true for port 465, false for port 587 with STARTTLS)
SMTP_SECURE=false

# SMTP Username (usually your email address)
SMTP_USER=

# SMTP Password (for Gmail, use App Password, not regular password)
# Gmail: Enable 2FA and generate at https://myaccount.google.com/apppasswords
SMTP_PASS=

# From address for emails (e.g., "Claude Code <noreply@example.com>")
SMTP_FROM=Claude Code <noreply@example.com>

# Common SMTP Providers:
# - Gmail: smtp.gmail.com (port 587, requires App Password)
# - Outlook: smtp-mail.outlook.com (port 587)
# - Yahoo: smtp.mail.yahoo.com (port 587 or 465)
# - SendGrid: smtp.sendgrid.net (port 587)
# - Custom: Use your email provider's SMTP settings
