# Docker Environment Configuration for Claude Code UI
# Copy this file to .env in the docker directory and update with your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
UI_PORT=3009
VITE_PORT=8080

# =============================================================================
# VOLUME MOUNT PATHS (Host Machine Paths)
# =============================================================================
# These paths will be mounted to the container
# Adjust these paths based on your host machine setup

# Projects directory - where user projects will be stored
PROJECTS_DIR=./data/projects

# Backup directory - where backups will be stored
BACKUP_DIR=./data/backup

# Database directory - where SQLite databases will be stored
DATABASE_DIR=./data/database

# Logs directory - where application logs will be stored
LOGS_DIR=./data/logs

# Optional: Path to existing .env file (will be mounted read-only)
ENV_FILE=../.env

# Optional: SSH directory for git operations (mount your SSH keys)
SSH_DIR=~/.ssh

# Optional: Git configuration file
GIT_CONFIG=~/.gitconfig

# =============================================================================
# GITHUB OAUTH CONFIGURATION
# =============================================================================
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3009/api/github/callback
GITHUB_ALLOWED_ORGS=
GITHUB_REQUIRED_STAR_REPO=
FRONTEND_URL=http://localhost:3009

# =============================================================================
# GITEA OAUTH CONFIGURATION
# =============================================================================
GITEA_INSTANCE_URL=
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
GITEA_REDIRECT_URI=http://localhost:3009/api/gitea/callback

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Claude Code <noreply@example.com>

# =============================================================================
# ANTHROPIC API CONFIGURATION
# =============================================================================
ANTHROPIC_AUTH_TOKEN=your_anthropic_api_token_here
ANTHROPIC_BASE_URL=

# =============================================================================
# CLI CONFIGURATION
# =============================================================================
CLAUDE_CLI_COMMAND=claude
FORCE_WSS=false