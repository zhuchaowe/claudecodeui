# Claude Code UI Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
PORT=3008
#Frontend port
VITE_PORT=8080

# =============================================================================
# GITHUB OAUTH CONFIGURATION
# =============================================================================
# To use GitHub OAuth, you need to create a GitHub OAuth App:
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Fill in:
#    - Application name: Claude Code UI
#    - Homepage URL: http://localhost:3008 (or your production URL)
#    - Authorization callback URL: http://localhost:3008/api/github/callback
# 4. After creating, copy the Client ID and Client Secret below

# GitHub OAuth App Client ID
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitHub OAuth Redirect URI (should match the callback URL in your GitHub app)
GITHUB_REDIRECT_URI=http://localhost:3008/api/github/callback

# GitHub Organization Restrictions (optional)
# Comma-separated list of GitHub organizations that are allowed to login
# Leave empty to allow any GitHub user to login
# Example: GITHUB_ALLOWED_ORGS=my-org,another-org
GITHUB_ALLOWED_ORGS=

# =============================================================================
# PROJECTS DIRECTORY CONFIGURATION
# =============================================================================
# Base directory where user projects are stored
# Each user will have their own subdirectory: {PROJECTS_DIR}/{username}
# Default: /home/claude/projects
PROJECTS_DIR=/home/claude/projects
