# Claude Code UI Production Environment Configuration for claudecode-dev.gbase.ai

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
PORT=3008

# Frontend port (if using Vite dev server in production)
VITE_PORT=8080

# Production URL
FRONTEND_URL=https://claudecode-dev.gbase.ai
API_URL=https://claudecode-dev.gbase.ai/api

# =============================================================================
# GITHUB OAUTH CONFIGURATION
# =============================================================================
# IMPORTANT: Update your GitHub OAuth App settings:
# Go to https://github.com/settings/developers and update:
# - Homepage URL: https://claudecode-dev.gbase.ai
# - Authorization callback URL: https://claudecode-dev.gbase.ai/api/github/callback

# GitHub OAuth App Client ID
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitHub OAuth Redirect URI (must match GitHub app settings)
GITHUB_REDIRECT_URI=https://claudecode-dev.gbase.ai/api/github/callback

# =============================================================================
# PROJECTS DIRECTORY CONFIGURATION
# =============================================================================
# Base directory where user projects are stored
PROJECTS_DIR=/home/claude/projects